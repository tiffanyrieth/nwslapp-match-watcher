#!/bin/sh
#
# pre-push — guard the default branch (main) against destructive pushes.
#
# Blocks two accidents outright:
#   • DELETING main on the remote
#   • FORCE-PUSHING main (a non-fast-forward push that rewrites history)
# A normal (fast-forward) push to main is allowed but warns, since the
# preferred path is a feature branch + PR.
#
# git feeds this hook one line per ref being pushed, on stdin:
#     <local ref> <local oid> <remote ref> <remote oid>
# For a deletion, <local oid> is all zeros. For a brand-new ref, <remote oid>
# is all zeros.
#
# Local guardrail, NOT security: bypass on purpose with `git push --no-verify`.
#

protected="main"
zero="0000000000000000000000000000000000000000"
status=0


# ── Personal-info content scan ────────────────────────────────────────────
# Blocks pushing any commit whose ADDED content or commit MESSAGE matches the
# private blocklist. The patterns live OUTSIDE the repo (in the operator's
# home dir) so the blocklist itself is never published. Metadata guards
# (no-reply author email, GitHub's "block pushes that expose my email") only
# check WHO authored a commit — this is the missing guard for what a commit
# CONTAINS. Bypass (on purpose only): git push --no-verify.
scan_blocklist="$HOME/.config/nwslapp/personal-blocklist.txt"

scan_commits() {
    _range_head="$1"; _range_base="$2"
    if [ ! -r "$scan_blocklist" ]; then
        echo "⚠️  personal-info scan SKIPPED: $scan_blocklist not found." >&2
        return 0
    fi
    if [ "$_range_base" = "$zero" ]; then
        _revs=$(git rev-list "$_range_head" --not --remotes 2>/dev/null)
    else
        _revs=$(git rev-list "$_range_base..$_range_head" 2>/dev/null)
    fi
    _scan_status=0
    for _c in $_revs; do
        _hits=$( {
            git show --no-patch --format=%B "$_c"
            git show --format= "$_c" | grep -E '^\+' | grep -v '^+++'
        } | grep -i -E -f "$scan_blocklist" )
        if [ -n "$_hits" ]; then
            echo "" >&2
            echo "🛑 PUSH BLOCKED: commit $(git rev-parse --short "$_c") contains personal info:" >&2
            echo "$_hits" | head -3 | sed 's/^/     /' >&2
            echo "   Remove it (amend/rebase) before pushing. Blocklist: $scan_blocklist" >&2
            echo "" >&2
            _scan_status=1
        fi
    done
    return $_scan_status
}

while read -r local_ref local_oid remote_ref remote_oid; do
    # content scan runs for EVERY ref (personal info must not reach ANY public branch)
    if [ "$local_oid" != "$zero" ]; then
        scan_commits "$local_oid" "$remote_oid" || status=1
    fi
    [ "$remote_ref" = "refs/heads/$protected" ] || continue

    if [ "$local_oid" = "$zero" ]; then
        echo "" >&2
        echo "✋ Refusing to DELETE '$protected' on the remote." >&2
        echo "   (To override on purpose: git push --no-verify)" >&2
        echo "" >&2
        status=1
    elif [ "$remote_oid" != "$zero" ] && \
         ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
        echo "" >&2
        echo "✋ Refusing to FORCE-PUSH '$protected' (non-fast-forward)." >&2
        echo "   This would rewrite published history." >&2
        echo "   (To override on purpose: git push --no-verify)" >&2
        echo "" >&2
        status=1
    else
        echo "⚠️  Pushing directly to '$protected' — prefer a feature branch + PR." >&2
    fi
done

exit $status
